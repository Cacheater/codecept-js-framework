{
  "name": "codecept-js-framework",
  "version": "1.0.0",
  "description": "Framework de automatizacion de pruebas Web y API con CodeceptJS, TypeScript, Playwright y REST",
  "type": "module",
  "scripts": {
    "test:web": "codeceptjs run --grep '@web'",
    "test:api": "codeceptjs run --grep '@api'",
    "test:all": "codeceptjs run",
    "test:web:headed": "HEADLESS=false codeceptjs run --grep '@web'",
    "codecept:def": "codeceptjs def",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "report": "npm run allure:generate && npm run allure:open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "codeceptjs",
    "playwright",
    "api-testing",
    "e2e",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "allure-codeceptjs": "^3.10.2",
    "allure-commandline": "^2.43.0",
    "codeceptjs": "^4.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
